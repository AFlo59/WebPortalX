@page "/Account/Profile"
@model ProfileModel
@{
    ViewData["Title"] = "Mon Profil";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">Mon Profil</h2>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Message))
                    {
                        <div class="alert alert-info mb-4">@Model.Message</div>
                    }

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h4>Informations personnelles</h4>
                            <dl class="row">
                                <dt class="col-sm-4">Nom d'utilisateur</dt>
                                <dd class="col-sm-8">@Model.UserName</dd>

                                <dt class="col-sm-4">Prénom</dt>
                                <dd class="col-sm-8">@Model.FirstName</dd>

                                <dt class="col-sm-4">Nom</dt>
                                <dd class="col-sm-8">@Model.LastName</dd>

                                <dt class="col-sm-4">Email</dt>
                                <dd class="col-sm-8">@Model.Email</dd>

                                <dt class="col-sm-4">Date de naissance</dt>
                                <dd class="col-sm-8">@Model.DateOfBirth.ToString("dd/MM/yyyy")</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h4>Statut du compte</h4>
                            <dl class="row">
                                <dt class="col-sm-4">Rôle</dt>
                                <dd class="col-sm-8"><span class="badge bg-info">@Model.Role</span></dd>

                                <dt class="col-sm-4">Statut</dt>
                                <dd class="col-sm-8">
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">Actif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactif</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Membre depuis</dt>
                                <dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
                            </dl>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/Account/EditProfile" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Modifier le profil
                        </a>
                        <form method="post" asp-page-handler="Logout" class="d-inline">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-box-arrow-right"></i> Se déconnecter
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
