@page
@model ProfileModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Mon Profil";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">Mon Profil</h2>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Message))
                    {
                        <div class="alert alert-info mb-4">@Model.Message</div>
                    }

                    <div class="profile-section">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="profile-card text-center">
                                    <img src="~/images/avatar.png" class="rounded-circle img-fluid mb-3" style="max-width: 150px;">
                                    <h3>@Model.UserName</h3>
                                    <p class="text-muted">@Model.Role</p>
                                    <div class="mt-3">
                                        <button class="btn btn-outline-primary btn-sm">Modifier l'avatar</button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="profile-card">
                                    <h2>Informations personnelles</h2>
                                    <dl class="row">
                                        <dt class="col-sm-4">Nom d'utilisateur</dt>
                                        <dd class="col-sm-8">@Model.UserName</dd>

                                        <dt class="col-sm-4">Prénom</dt>
                                        <dd class="col-sm-8">@Model.FirstName</dd>

                                        <dt class="col-sm-4">Nom</dt>
                                        <dd class="col-sm-8">@Model.LastName</dd>

                                        <dt class="col-sm-4">Email</dt>
                                        <dd class="col-sm-8">@Model.Email</dd>

                                        <dt class="col-sm-4">Date de naissance</dt>
                                        <dd class="col-sm-8">@Model.DateOfBirth.ToString("dd/MM/yyyy")</dd>
                                    </dl>
                                </div>
                                
                                <div class="profile-card mt-4">
                                    <h2>Statistiques</h2>
                                    <div class="row text-center">
                                        <div class="col-4">
                                            <h4>0</h4>
                                            <p>Parties jouées</p>
                                        </div>
                                        <div class="col-4">
                                            <h4>0</h4>
                                            <p>Personnages créés</p>
                                        </div>
                                        <div class="col-4">
                                            <h4>0</h4>
                                            <p>Histoires générées</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a href="/Account/EditProfile" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Modifier le profil
                        </a>
                        <form method="post" asp-page-handler="Logout" class="d-inline">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-box-arrow-right"></i> Se déconnecter
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
