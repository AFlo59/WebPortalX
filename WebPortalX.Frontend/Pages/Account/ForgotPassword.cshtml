@page "/Account/ForgotPassword"
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Mot de passe oublié";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">Réinitialisation du mot de passe</h2>
                </div>
                <div class="card-body">
                    <p class="card-text mb-4">
                        Entrez votre adresse email pour recevoir un lien de réinitialisation.
                    </p>

                    @if (!string.IsNullOrEmpty(Model.Message))
                    {
                        <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger") mb-4">
                            @Model.Message
                        </div>
                    }

                    <form method="post" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" type="email" class="form-control" required />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="/Account/Login" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Retour à la connexion
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-envelope"></i> Envoyer le lien
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 