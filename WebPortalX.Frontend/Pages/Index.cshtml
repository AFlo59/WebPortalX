@page
@model IndexModel
@{
    ViewData["Title"] = "Accueil";
}

<div class="hero-section text-center py-5">
    <h1 class="display-4 mb-4">Bienvenue dans l'univers des RPG IA</h1>
    <p class="lead mb-4">Créez, jouez et partagez des aventures uniques générées par intelligence artificielle</p>
    @if (!User.Identity.IsAuthenticated)
    {
        <div class="mb-4">
            <a asp-page="/Account/Register" class="btn btn-primary btn-lg me-3">Commencer l'aventure</a>
            <a asp-page="/Account/Login" class="btn btn-outline-secondary btn-lg">Se connecter</a>
        </div>
    }
</div>

<div class="container">
    <div class="row g-4 py-5">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-dice-d20 fa-3x mb-3 text-primary"></i>
                    <h3>Création de Personnages</h3>
                    <p>Créez des personnages uniques avec l'aide de l'IA</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-book-open fa-3x mb-3 text-primary"></i>
                    <h3>Histoires Dynamiques</h3>
                    <p>Des scénarios qui s'adaptent à vos choix</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-users fa-3x mb-3 text-primary"></i>
                    <h3>Communauté Active</h3>
                    <p>Partagez vos aventures avec d'autres joueurs</p>
                </div>
            </div>
        </div>
    </div>
</div>
